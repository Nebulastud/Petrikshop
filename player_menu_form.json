{
  "namespace": "player_menu_ui",
  "main_screen": {
    "type": "panel",
    "size": [
      "60%",
      "55%"
    ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "bg": {
          "type": "image",
          "size": [
            "100%",
            "100%"
          ],
          "fill": true,
          "texture": "textures/ui/newbg",
          "layer": 1
        }
      },
      {
        "border": {
          "type": "image",
          "size": [
            "100%",
            "100%"
          ],
          "texture": "textures/ui/border",
          "layer": 2
        }
      },
      {
        "content_wrapper": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [
            "100% - 7px",
            "100% - 7px"
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 5,
          "controls": [
            {
              "left_side": {
                "type": "panel",
                "size": [
                  "30%",
                  "100%"
                ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "bg": {
                      "type": "image",
                      "size": [
                        "100% - 2px",
                        "100% - 2px"
                      ],
                      "texture": "textures/ui/bg_admin_transparent",
                      "layer": 1
                    }
                  },
                  {
                    "clipping_container": {
                      "type": "panel",
                      "size": [
                        "100% - 4px",
                        "100% - 4px"
                      ],
                      "layer": 2,
                      "clips_children": true,
                      "controls": [
                        {
                          "player_model@player_menu_ui.player_preview": {
                            "layer": 1
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "middle_padding": {
                "type": "panel",
                "size": [
                  1,
                  "100%"
                ]
              }
            },
            {
              "right_side": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [
                  "fill",
                  "100%"
                ],
                "anchor_from": "center",
                "anchor_to": "center",
                "layer": 5,
                "controls": [
                  {
                    "header": {
                      "type": "stack_panel",
                      "orientation": "horizontal",
                      "size": [
                        "100%",
                        28
                      ],
                      "controls": [
                        {
                          "left": {
                            "type": "panel",
                            "size": [
                              "fill",
                              "100%"
                            ],
                            "controls": [
                              {
                                "bg": {
                                  "type": "image",
                                  "size": [
                                    "100% - 2px",
                                    "100% - 2px"
                                  ],
                                  "texture": "textures/ui/bg_admin_transparent",
                                  "layer": 1
                                }
                              },
                              {
                                "title": {
                                  "type": "label",
                                  "text": "PLAYER MENU",
                                  "font_scale_factor": 1.6,
                                  "anchor_from": "center",
                                  "anchor_to": "center",
                                  "layer": 3,
                                  "offset": [
                                    0,
                                    -1
                                  ],
                                  "color": [
                                    0.32,
                                    0.32,
                                    0.32
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "padding": {
                            "type": "panel",
                            "size": [
                              1,
                              "100%"
                            ]
                          }
                        },
                        {
                          "cls": {
                            "type": "panel",
                            "size": [
                              "100%y",
                              "100%"
                            ],
                            "controls": [
                              {
                                "close_button_style@common_buttons.light_text_button": {
                                  "size": [
                                    "100% - 2px",
                                    "100% - 2px"
                                  ],
                                  "anchor_from": "center",
                                  "anchor_to": "center",
                                  "$button_text": "",
                                  "$default_button_texture": "textures/ui/close_admin_transparent",
                                  "$hover_button_texture": "textures/ui/closepress_admin_transparent",
                                  "$pressed_button_texture": "textures/ui/closepress_admin_transparent",
                                  "$pressed_button_name": "button.menu_exit",
                                  "button_mappings": [
                                    {
                                      "from_button_id": "button.menu_select",
                                      "to_button_id": "button.menu_exit",
                                      "mapping_type": "pressed"
                                    },
                                    {
                                      "from_button_id": "button.menu_ok",
                                      "to_button_id": "button.menu_exit",
                                      "mapping_type": "focused"
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "padding_header": {
                      "type": "panel",
                      "size": [
                        "100%",
                        2
                      ]
                    }
                  },
                  {
                    "empty_area": {
                      "type": "panel",
                      "size": [
                        "100%",
                        "fill"
                      ],
                      "controls": [
                        {
                          "scrolling_panel@common.scrolling_panel": {
                            "anchor_from": "top_middle",
                            "anchor_to": "top_middle",
                            "size": [
                              "100%",
                              "100%"
                            ],
                            "$scrolling_content": "player_menu_ui.content_panel_A",
                            "$show_background": false,
                            "$scroll_size": [
                              5,
                              "100% - 4px"
                            ],
                            "$scrolling_pane_size": [
                              "100% - 8px",
                              "100%"
                            ],
                            "$scrolling_pane_offset": [
                              0,
                              0
                            ],
                            "$scroll_bar_right_padding_size": [
                              0,
                              0
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "content_panel_A": {
    "type": "panel",
    "size": [
      "100%",
      "100%c"
    ],
    "controls": [
      {
        "button_grid_content": {
          "type": "grid",
          "grid_dimensions": [
            3,
            0
          ],
          "size": [
            174,
            "100%c"
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "grid_rescaling_type": "horizontal",
          "grid_item_template": "player_menu_ui.button_style",
          "grid_fill_direction": "horizontal",
          "factory": {
            "name": "buttons",
            "control_name": "player_menu_ui.button_style"
          },
          "collection_name": "form_buttons",
          "bindings": [
            {
              "binding_name": "#form_button_length",
              "binding_name_override": "#maximum_grid_items"
            }
          ]
        }
      }
    ]
  },
  "button_style": {
    "type": "panel",
    "size": [
      58,
      58
    ],
    "$default_button_texture": "textures/ui/btn_admin_transparent",
    "$hover_button_texture": "textures/ui/btnpress_admin_transparent",
    "$pressed_button_texture": "textures/ui/btnpress_admin_transparent",
    "controls": [
      {
        "main_ui": {
          "type": "panel",
          "size": [
            50,
            50
          ],
          "controls": [
            {
              "panel_name": {
                "type": "panel",
                "size": [
                  50,
                  50
                ],
                "controls": [
                  {
                    "button_back": {
                      "type": "image",
                      "size": [
                        50,
                        50
                      ],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "offset": [
                        0,
                        0
                      ],
                      "texture": "textures/ui/btn_admin_transparent",
                      "layer": 1
                    }
                  },
                  {
                    "icon": {
                      "type": "image",
                      "layer": 30,
                      "size": [
                        24,
                        24
                      ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "offset": [
                        0,
                        -7
                      ],
                      "bindings": [
                        {
                          "binding_name": "#form_button_texture",
                          "binding_name_override": "#texture",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        },
                        {
                          "binding_name": "#form_button_texture_file_system",
                          "binding_name_override": "#texture_file_system",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "text_with_icon": {
                      "type": "label",
                      "text": "#form_button_text",
                      "layer": 32,
                      "size": [
                        "100% - 6px",
                        "default"
                      ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "text_alignment": "center",
                      "offset": [
                        0,
                        16
                      ],
                      "color": [
                        1,
                        1,
                        1
                      ],
                      "font_scale_factor": 0.62,
                      "bindings": [
                        {
                          "binding_name": "#form_button_text",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "form_button@common_buttons.light_text_button": {
                "size": [
                  50,
                  50
                ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  0,
                  0
                ],
                "$pressed_button_name": "button.form_button_click",
                "$button_text": "",
                "bindings": [
                  {
                    "binding_type": "collection_details",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            0,
            0
          ]
        }
      }
    ]
  },
  "right_button_style": {
    "type": "panel",
    "size": [
      "100%",
      "100%x"
    ],
    "$default_button_texture": "textures/ui/btn_admin_transparent",
    "$hover_button_texture": "textures/ui/btnpress_admin_transparent",
    "$pressed_button_texture": "textures/ui/btnpress_admin_transparent",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (('_' + #form_button_text) - '§m§e§m§b§e§r' = ('_' + #form_button_text)))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "main_ui": {
          "type": "panel",
          "size": [
            "100% - 3px",
            "100% - 3px"
          ],
          "controls": [
            {
              "panel_name": {
                "type": "panel",
                "size": [
                  "100% - 2px",
                  "100% - 2px"
                ],
                "controls": [
                  {
                    "icon": {
                      "type": "image",
                      "layer": 30,
                      "size": [
                        25,
                        25
                      ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "offset": [
                        0,
                        0
                      ],
                      "bindings": [
                        {
                          "binding_name": "#form_button_texture",
                          "binding_name_override": "#texture",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        },
                        {
                          "binding_name": "#form_button_texture_file_system",
                          "binding_name_override": "#texture_file_system",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "form_button@common_buttons.light_text_button": {
                "size": [
                  "100%",
                  "100%"
                ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "$pressed_button_name": "button.form_button_click",
                "$button_text": "",
                "bindings": [
                  {
                    "binding_type": "collection_details",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "player_preview": {
    "type": "custom",
    "renderer": "live_player_renderer",
    "property_bag": {
      "#look_at_cursor": true
    },
    "animation_reset_name": "screen_animation_reset",
    "anims": [
      "@common.screen_exit_size_animation_push",
      "@common.screen_exit_size_animation_pop",
      "@common.screen_entrance_size_animation_push",
      "@common.screen_entrance_size_animation_pop"
    ],
    "size": [
      "100%",
      "100%"
    ],
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 10
  }
}